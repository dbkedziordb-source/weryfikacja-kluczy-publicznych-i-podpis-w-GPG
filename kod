#SHA
printf 'obraz kursu\n' > obraz.iso
sha256sum obraz.iso > SHA256SUMS
sha256sum -c SHA256SUMS
printf 'zmiana\n' >> obraz.iso
sha256sum -c SHA256SUMS

#GPG
mkdir -p gpg-lab && chmod 700 gpg-lab
export GNUPGHOME="$PWD/gpg-lab"
gpg --quick-generate-key \
  'Alicja Lab <alicja@example.test>' ed25519 sign 1y
gpg --list-secret-keys --keyid-format LONG

gpg --fingerprint 'alicja@example.test'
gpg --armor --export 'alicja@example.test' > pubkey.asc
# partner otrzymuje pubkey.asc
gpg --import partner-pubkey.asc
gpg --fingerprint 'bob@example.test'

printf 'raport zatwierdzony\n' > message.txt
gpg --armor --detach-sign \
  -o message.sig.asc message.txt
gpg --verify message.sig.asc message.txt
printf 'zmiana\n' >> message.txt
gpg --verify message.sig.asc message.txt

#TLS
openssl s_client -connect example.com:443 \
  -servername example.com -showcerts \
  -verify_hostname example.com \
  -verify_return_error </dev/null

openssl s_client -connect example.com:443 \
  -servername example.com </dev/null 2>/dev/null \
  | openssl x509 -noout -subject -issuer \
      -dates -ext subjectAltName
